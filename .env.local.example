# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Providers (add only the ones you have)
XAI_API_KEY=your_grok_key
ANTHROPIC_API_KEY=your_claude_key
OPENAI_API_KEY=your_openai_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key
TOGETHER_API_KEY=your_together_key
DEEPSEEK_API_KEY=your_deepseek_key

# Router Configuration
# Comma-separated list of providers in order of preference for failover.
# Options: openai, anthropic, google, xai, deepseek, together, openrouter
AI_PROVIDER_ORDER=openai,anthropic,google,xai,deepseek,together,openrouter

# Optional later
ELEVENLABS_API_KEY=
